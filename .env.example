# Copy to .env and fill in the key for your chosen provider.
TRIPMATE_PROVIDER=groq
GROQ_API_KEY=

# For TRIPMATE_PROVIDER=anthropic instead:
# ANTHROPIC_API_KEY=

# Optional -- every one of these has a working default.
# See the configuration table in README.md.
# TRIPMATE_MODEL=
# TRIPMATE_MAX_TOKENS=4096
# TRIPMATE_TEMPERATURE=0.2
# TRIPMATE_MAX_ITERATIONS=6
# TRIPMATE_MAX_HISTORY_TURNS=6
# TRIPMATE_TIMEOUT_S=60
# TRIPMATE_TOP_K=3
# TRIPMATE_MIN_SIMILARITY=
# TRIPMATE_LOG_LEVEL=INFO
# TRIPMATE_LOG_FILE=
